# ==============================================================================
# Vidhik Platform - Production-Grade Environment Configuration Template
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vidhik_db
DB_USER=postgres
DB_PASSWORD=your_postgres_password_here
DATABASE_URL=postgresql://postgres:your_postgres_password_here@localhost:5432/vidhik_db

# Connection Pool Settings
DB_MIN_CONN=1
DB_MAX_CONN=10

# Application Configuration
APP_ENV=development
DEBUG=True
APP_HOST=127.0.0.1
APP_PORT=8000

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000

# Security & Authentication (JWT & Session Configuration)
SESSION_SECRET=vidhik-production-session-crypto-key-replace-with-64-char-hex
JWT_SECRET_KEY=vidhik-production-jwt-signed-token-secret-replace-with-64-char-hex
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiter & Brute-Force Protection
RATE_LIMIT_REQUESTS_PER_MINUTE=60
AUTH_RATE_LIMIT_PER_MINUTE=20
MAX_FAILED_LOGIN_ATTEMPTS=5
ACCOUNT_LOCKOUT_MINUTES=15

# Cloudflare Turnstile CAPTCHA (Real Anti-Bot Verification)
# ------------------------------------------------------------------------------
# LOCAL DEVELOPMENT / TESTING:
# Cloudflare official dummy test keys may be used only when APP_ENV=development:
#   Site Key (Always passes):   1x00000000000000000000AA
#   Secret Key (Always passes): 1x0000000000000000000000000000000AA
#
# PRODUCTION ENVIRONMENT (APP_ENV=production):
# Cloudflare test keys are strictly prohibited and will be rejected by the backend.
# Real keys MUST be generated from the Cloudflare Dashboard:
#   1. Navigate to: https://dash.cloudflare.com/?to=/:account/turnstile
#   2. Create a new Turnstile widget targeting your production domain (e.g., app.vidhik.ai).
#   3. Choose widget type: Managed (recommended) or Non-interactive.
#   4. Copy the public Site Key and Secret Key into your production environment variables.
#   5. Configure TURNSTILE_EXPECTED_HOSTNAME to match your production domain.
# ------------------------------------------------------------------------------
TURNSTILE_SITE_KEY=your_production_turnstile_site_key_here
TURNSTILE_SECRET_KEY=your_production_turnstile_secret_key_here
TURNSTILE_EXPECTED_HOSTNAME=app.vidhik.ai

# Google OAuth 2.0 / OpenID Connect (Real Google Identity Verification)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret

# Email Verification & Security Alerts (SMTP / Resend / SendGrid)
EMAIL_PROVIDER=smtp
EMAIL_PROVIDER_API_KEY=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=no-reply@vidhik.ai
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM_EMAIL=no-reply@vidhik.ai
SMTP_FROM_NAME="Vidhik Legal Security"

# Phone / SMS OTP Verification (Twilio / MSG91)
SMS_PROVIDER=log
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_SENDER_ID=VIDHIK
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# AI / LLM Provider Configuration ('mock', 'gemini', or 'openai')
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
