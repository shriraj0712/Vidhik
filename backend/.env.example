# ==============================================================================
# Vidhik Platform - Backend Environment Configuration Example
# ==============================================================================

# Database Configuration (PostgreSQL)
DB_HOST=localhost
DB_PORT=5432
DB_NAME=vidhik_db
DB_USER=postgres
DB_PASSWORD=your_password_here

# Connection Pool Settings
DB_MIN_CONN=1
DB_MAX_CONN=10

# Application Configuration
APP_ENV=development
DEBUG=True
APP_HOST=127.0.0.1
APP_PORT=8000

# CORS Configuration (Comma-separated list of allowed origins)
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000

# Security & Authentication (JWT & Session Configuration)
JWT_SECRET_KEY=change-me-in-production-use-a-strong-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Rate Limiter Configuration
RATE_LIMIT_REQUESTS_PER_MINUTE=60

# AI / LLM Provider Configuration ('mock', 'gemini', or 'openai')
LLM_PROVIDER=mock
GEMINI_API_KEY=
OPENAI_API_KEY=
